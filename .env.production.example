# =============================================================================
# Interactive Contract & RFP Redlining Studio — Production Environment Template
# Copy to `.env.production` and provision secrets via Docker Swarm / K8s Secrets.
#
# NOTE: Do NOT source this file directly (e.g. '. ./.env.production'). Pass via
# 'docker compose --env-file .env.production -f docker-compose.prod.yml up -d'.
# =============================================================================

# --- Application & Runtime ---
APP_ENV=production
APP_NAME="Interactive Contract & RFP Redlining Studio"
API_V1_PREFIX=/api/v1
DOMAIN_NAME=redline.example.com
CORS_ALLOWED_ORIGINS='["https://redline.example.com"]'

# --- PostgreSQL 16 (pgvector) & Redis 7 ---
POSTGRES_USER=redline_app
POSTGRES_DB=redlining_studio
POSTGRES_PORT=5432
# In production, enforce TLS/mTLS (ssl=verify-full) on PostgreSQL connections:
DATABASE_URL="postgresql+asyncpg://redline_app:CHANGE_ME_STRONG_DB_PASS@postgres:5432/redlining_studio?ssl=verify-full"
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Authentication & Secret File Mounts (Docker Swarm / Kubernetes) ---
# Secrets can be injected via mounted files (*_FILE) or direct env vars:
JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI & Vector Knowledge Base Providers (Groq / OpenAI / Anthropic / Gemini / Local Ollama / vLLM) ---
# External/local providers carry zero hardcoded default model names so configurations stay future-proof.
# Specify an explicit model ID below OR switch at runtime via the In-App AI Switcher (Fetch Live Models).
LLM_PROVIDER=deterministic
LLM_MODEL_NAME=
# LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60.0
REDLINE_BATCH_CONCURRENCY=20
REDLINE_MAX_RETRIES=2
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
GROQ_API_KEY_FILE=/run/secrets/groq_api_key

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30.0
PLAYBOOK_DEFAULT_TOP_K=3
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- Upload Storage & Rate Limiting ---
MAX_UPLOAD_SIZE_MB=25
STORAGE_ROOT_PATH=/var/lib/redlining_studio/storage
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend Public API & Workspace Mode ---
NEXT_PUBLIC_API_BASE_URL=https://redline.example.com/api/v1
# Starts in clean Real Workspace Mode by default (users can toggle Demo Sandbox anytime in UI)
NEXT_PUBLIC_DEFAULT_DEMO_MODE=false

