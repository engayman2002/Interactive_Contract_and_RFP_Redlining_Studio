# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME="Interactive Contract & RFP Redlining Studio"
API_V1_PREFIX=/api/v1

# Server Binding (MUST bind to 127.0.0.1 in development/testing)
HOST=127.0.0.1
PORT=8000

# PostgreSQL 16 + pgvector Configuration (Least-Privilege Application User)
POSTGRES_USER=redline_app
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=redlining_studio
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://redline_app:replace_with_strong_random_db_password@127.0.0.1:5432/redlining_studio

# Redis 7 Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# JWT & Security Configuration
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_char_cryptographic_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (Strict allow-list, no wildcards)
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

